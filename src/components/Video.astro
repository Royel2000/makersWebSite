---
const CHANNEL_ID = "UClpgO6x3-xCI8opTuWcmMUA";
const MAIN_VIDEO = "IVYbODWOXFA";

let videos: { id: string; title: string; thumb: string }[] = [];

try {
  const res = await fetch(
    `https://www.youtube.com/feeds/videos.xml?channel_id=${CHANNEL_ID}`,
  );
  const xml = await res.text();
  const entries = [...xml.matchAll(/<entry>([\s\S]*?)<\/entry>/g)];
  videos = entries
    .map((e) => {
      const content = e[1];
      const id = (content.match(/<yt:videoId>(.*?)<\/yt:videoId>/) || [])[1];
      const title = (content.match(/<title>(.*?)<\/title>/) || [])[1];
      return {
        id,
        title,
        thumb: `https://i.ytimg.com/vi/${id}/mqdefault.jpg`,
      };
    })
    .filter((v) => v.id)
    .slice(0, 20);
} catch (e) {
  videos = [];
}

const mainVideo =
  videos.length > 0
    ? videos[0]
    : {
        id: MAIN_VIDEO,
        title: "Video promocional Makers",
        thumb: `https://i.ytimg.com/vi/${MAIN_VIDEO}/mqdefault.jpg`,
      };
const carouselVideos = videos;
---

<section
  id="video"
  class="w-full py-16 px-5 md:px-10 lg:px-20"
  style="font-family:'Outfit',sans-serif;"
>
  <!-- Eyebrow -->
  <div
    class="flex flex-col md:flex-row items-start md:items-end justify-center gap-6 mb-10"
  >
    <!-- Título izquierda -->
    <div class="text-left">
      <p class="text-[10px] font-bold uppercase text-[#f95602]/70 mb-1">
        Nuestro trabajo
      </p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white">
        En <span class="text-[#f95602]">movimiento</span>
      </h2>
    </div>

    <!-- Frase derecha -->
    <div class="text-left md:text-right max-w-xs">
      <p class="text-sm md:text-base leading-relaxed text-neutral-500 italic">
        "Las fotos detienen el tiempo.<br>El video lo devuelve."
      </p>
    </div>
  </div>

  <!-- Video principal -->
  <div
    class="relative w-full rounded-2xl overflow-hidden bg-black mx-auto"
    style="aspect-ratio:16/9;max-width:780px;"
    id="main-player-wrap"
    data-video-id={mainVideo.id}
  >
    <!-- Poster -->
    <div id="main-poster" class="absolute inset-0 z-10 cursor-pointer group">
      <img
        id="main-thumb"
        src={mainVideo.thumb.replace("mqdefault", "maxresdefault")}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
        alt={mainVideo.title}
      />
      <div
        class="absolute inset-0"
        style="background:linear-gradient(to top,rgba(0,0,0,0.7) 0%,rgba(0,0,0,0.1) 60%,transparent 100%);"
      >
      </div>
      <div
        class="absolute inset-0 flex flex-col items-center justify-center gap-4"
      >
        <div
          class="w-16 h-16 md:w-20 md:h-20 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110"
          style="background:rgba(1,1,1,0.95);border:2px solid rgba(255,255,255,0.15);box-shadow:0 0 40px rgba(1,1,1,0.4);"
        >
          <i
            class="ti ti-player-play text-white"
            style="font-size:28px;margin-left:4px;"></i>
        </div>
      </div>
      <div class="absolute bottom-0 left-0 right-0 p-5">
        <p class="text-[10px] font-bold uppercase text-[#f95602]/80 mb-1">
          Video promocional
        </p>
        <p id="main-title" class="text-white font-bold text-lg leading-tight">
          {mainVideo.title}
        </p>
      </div>
    </div>

    <!-- iframe -->
    <iframe
      id="main-iframe"
      class="w-full h-full opacity-0 transition-opacity duration-500"
      src=""
      title="Video Makers"
      allow="autoplay; fullscreen"
      allowfullscreen
      style="position:absolute;inset:0;"></iframe>
  </div>

  <!-- Carrusel de videos -->
  {
    carouselVideos.length > 0 && (
      <div class="mt-5 relative">
        <div
          class="flex gap-3 overflow-x-auto pb-2 scroll-smooth justify-start md:justify-center"
          id="video-carousel"
          style="scrollbar-width:none;-ms-overflow-style:none;"
        >
          {carouselVideos.map((v) => (
            <button
              class="video-thumb-btn group relative rounded-xl overflow-hidden flex-shrink-0 border border-white/[0.08] transition-all duration-300 hover:border-[#f95602]/60 focus:outline-none"
              style="width:200px;height:112px;"
              data-id={v.id}
              data-title={v.title}
            >
              <img
                src={v.thumb}
                alt={v.title}
                class="w-full h-full object-cover opacity-60 group-hover:opacity-90 transition-opacity duration-300"
              />
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors duration-300" />
              <div
                class="absolute bottom-0 left-0 right-0 p-2"
                style="background:linear-gradient(to top,rgba(0,0,0,0.8),transparent);"
              >
                <p class="text-white text-[10px] font-semibold leading-tight line-clamp-2 text-left">
                  {v.title}
                </p>
              </div>
            </button>
          ))}
        </div>
      </div>
    )
  }
</section>

<script is:inline>
  const mainPoster = document.getElementById("main-poster");
  const mainIframe = document.getElementById("main-iframe");
  const mainThumb = document.getElementById("main-thumb");
  const mainTitle = document.getElementById("main-title");
  const MAIN_ID = document.getElementById("main-player-wrap").dataset.videoId;

  function playVideo(id, title, thumbSrc) {
    mainThumb.src = thumbSrc.replace("mqdefault", "maxresdefault");
    if (mainTitle) mainTitle.textContent = title;

    document.querySelectorAll(".video-thumb-btn").forEach((btn) => {
      btn.style.borderColor =
        btn.dataset.id === id ? "#f95602" : "rgba(255,255,255,0.08)";
    });

    mainIframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&controls=1&rel=0`;
    mainIframe.style.opacity = "1";
    mainPoster.style.opacity = "0";
    mainPoster.style.pointerEvents = "none";

    document
      .getElementById("main-player-wrap")
      .scrollIntoView({ behavior: "smooth", block: "start" });
  }

  // Click en poster — siempre reproduce el video principal hardcoded
  mainPoster.addEventListener("click", () => {
    playVideo(MAIN_ID, mainTitle?.textContent || "", mainThumb?.src || "");
  });

  // Click en miniaturas del carrusel
  document.querySelectorAll(".video-thumb-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      playVideo(
        btn.dataset.id,
        btn.dataset.title,
        btn.querySelector("img").src,
      );
    });
  });
</script>

<style is:global>
  #video-carousel::-webkit-scrollbar {
    display: none;
  }
</style>
