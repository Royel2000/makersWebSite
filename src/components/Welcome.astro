---
import ".././assets/global.css";
import portada from "../assets/Portada.jpg";
import Logo from "../assets/Makers.svg";
import portadaMobile from "../assets/PortadaMobile.jpg";
import Valores from "./Valores.astro";
import Galeria from "./Galerias/Galeria.astro";
import Boda from "./Galerias/Boda.astro";
import Video from "./Video.astro";
import Planes from "./Planes.astro";
import Posters from "./Galerias/Posters.astro";
import Calculadora from "./Calculadora.astro";
import { Image } from "astro:assets";
import FAQ from "./FAQ.astro";
---

<div>
  <div class="hero relative h-screen overflow-hidden bg-[#0a0a0a]">
    <!-- Fondo con parallax -->
    <div
      id="heroBg"
      class="absolute inset-0 will-change-transform transition-transform duration-75 ease-linear"
      style="margin: -60px 0;"
    >
      <Image
        src={portada}
        class="hidden md:block w-full h-full object-cover"
        alt="Portada Makers"
        loading="eager"
      />
      <Image
        src={portadaMobile}
        class="block md:hidden w-full h-full object-cover"
        alt="Portada Makers"
        loading="eager"
      />
    </div>

    <!-- Overlay (Gradiente Original Restaurado) -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 25%, rgb(17, 17, 17) 100%);"
    >
    </div>

    <!-- Tarjeta glassmorphism minimalista -->
    <div class="absolute inset-0 flex items-end justify-center p-8 md:p-12">
      <div
        id="glassCard"
        class="w-auto max-w-md rounded-2xl p-6 text-[#cacaca] hover:scale-105 transition-all duration-300"
        style="
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.1);
  "
      >
        <Image src={Logo} class="w-1/3 mb-3" alt="Makers" loading="eager" />
        <p class="text-xl leading-snug text-white">
          Momentos únicos, <br class="sm:hidden" />
          <span class="inline-flex items-center min-h-[1.5em]">
            <span id="typewriter" class="transition-colors duration-300"></span>
            <span
              id="typewriter-cursor"
              class="animate-pulse ml-0.5 font-normal">|</span
            >
          </span>
        </p>
        <p class="text-sm mt-1 text-zinc-500">
          Felipe Carrillo Puerto, Quintana Roo
        </p>
      </div>
    </div>

    <!-- Indicador de scroll -->
    <div
      class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 opacity-40"
    >
      <div
        class="w-px h-8 origin-top animate-[scrollLine_1.8s_ease-in-out_infinite]"
      >
      </div>
    </div>
  </div>

  <Valores />

  <Video />

  <section
    id="aboutUs"
    class="bg-[#111111] text-[#cacaca] py-20 px-6 md:px-16 lg:px-32"
  >
    <div
      class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20"
    >
      <!-- Texto principal -->
      <div>
        <p class="font-bold uppercase text-[#f95602] mb-3">¿Quiénes somos?</p>
        <h2
          class="text-4xl md:text-5xl font-extrabold leading-tight text-white mb-3"
        >
          Fotografía que <span class="text-[#f95602]">cuenta historias</span>
        </h2>
        <p class="leading-relaxed text-[#cacaca]/90">
          Somos fotógrafos apasionados por capturar momentos que trascienden la
          imagen. Nos especializamos en sesiones creativas que reflejan la
          esencia, personalidad y emoción de cada persona.
          <br /><br />
          Originarios de Felipe Carrillo Puerto, Quintana Roo, transformamos ideas
          en recuerdos visuales únicos.
        </p>
      </div>

      <!-- Misión y Visión -->
      <div class="flex flex-col gap-4">
        <div
          class="relative rounded-xl border border-white/[0.07] bg-white/2 p-6 overflow-hidden"
        >
          <p class="text-2xl font-bold uppercase text-[#f95602] mb-2">Misión</p>
          <p class="leading-relaxed text-[#cacaca]/80">
            Evolucionar en cada proyecto, superándonos constantemente en
            creatividad, técnica y calidad, ofreciendo un servicio accesible sin
            perder el valor artístico que nos define.
          </p>
        </div>

        <div
          class="relative rounded-xl border border-white/[0.07] bg-white/2 p-6 overflow-hidden"
        >
          <p class="text-2xl font-bold uppercase text-[#f95602] mb-2">Visión</p>
          <p class="leading-relaxed text-[#cacaca]/80">
            Convertirnos en un estudio fotográfico consolidado, destacando por
            nuestra composición, estilo y calidad visual, hasta ser reconocidos
            como referentes de la fotografía en la península.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="w-full text-[#cacaca] py-8">
    <div class="flex justify-center px-4 mb-12">
      <div
        class="inline-flex flex-wrap items-center justify-center gap-2 bg-[#111111]"
      >
        <!-- Pestaña: Casual -->
        <button
          class="tab-btn active relative px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide transition-all duration-300 text-white cursor-pointer select-none overflow-hidden group"
          data-tab="galeria"
        >
          <span
            class="tab-bg absolute inset-0 bg-[#f95602] rounded-full transition-opacity duration-500 ease-in-out opacity-100"
          ></span>
          <span class="relative z-10">CASUAL</span>
        </button>

        <!-- Pestaña: Boda -->
        <button
          class="tab-btn relative px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide transition-all duration-300 text-[#cacaca] hover:text-white cursor-pointer select-none overflow-hidden group"
          data-tab="boda"
        >
          <span
            class="tab-bg absolute inset-0 bg-[#f95602] rounded-full transition-opacity duration-500 ease-in-out opacity-0"
          ></span>
          <span class="relative z-10">BODA</span>
        </button>

        <!-- Pestaña: XV Años (Deshabilitada) -->
        <button
          class="tab-btn relative px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide text-[#cacaca]/40 cursor-not-allowed flex items-center gap-2 select-none"
          data-tab="xv"
          disabled
        >
          <span>XV AÑOS</span>
          <span
            class="text-[9px] uppercase px-2 py-0.5 rounded-full bg-white/5 text-[#cacaca]/40 border border-white/5"
            >Próx</span
          >
        </button>

        <!-- Pestaña: Infantiles (Deshabilitada) -->
        <button
          class="tab-btn relative px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide text-[#cacaca]/40 cursor-not-allowed flex items-center gap-2 select-none"
          data-tab="infantiles"
          disabled
        >
          <span>INFANTILES</span>
          <span
            class="text-[9px] uppercase px-2 py-0.5 rounded-full bg-white/5 text-[#cacaca]/40 border border-white/5"
            >Próx</span
          >
        </button>
      </div>
    </div>

    <!-- CONTENIDO DE LAS PESTAÑAS -->
    <div>
      <div id="galeria" class="tab-content">
        <Galeria />
      </div>

      <div id="boda" class="tab-content hidden">
        <Boda />
      </div>

      <div id="xv" class="tab-content hidden">
        <div
          class="text-center py-16 px-4 max-w-md mx-auto border border-white/10 rounded-2xl bg-[#111111]"
        >
          <h3 class="font-bold text-2xl text-[#f95602] mb-2">PRÓXIMAMENTE</h3>
          <p class="text-sm text-[#cacaca] leading-relaxed">
            Estamos preparando la galería de XV años. Visita nuestras redes
            sociales para ver adelantos de nuestras sesiones.
          </p>
        </div>
      </div>

      <div id="infantiles" class="tab-content hidden">
        <div
          class="text-center py-16 px-4 max-w-md mx-auto border border-white/10 rounded-2xl bg-[#111111]"
        >
          <h3 class="font-bold text-2xl text-[#f95602] mb-2">PRÓXIMAMENTE</h3>
          <p class="text-sm text-[#cacaca] leading-relaxed">
            Pronto compartiremos nuestro trabajo en fotografía infantil.
            Síguenos en redes para no perdértelo.
          </p>
        </div>
      </div>
    </div>

    <!-- MODAL -->
    <div
      id="modal"
      class="fixed inset-0 bg-black/80 backdrop-blur-md hidden items-center justify-center z-50 p-4"
    >
      <img
        id="modalImg"
        class="max-w-[90%] max-h-[90%] rounded-2xl border border-white/10 transition-transform duration-300 scale-95 object-contain"
      />
    </div>
  </section>

  <Posters />

  <section class="text-[#cacaca] justify-center content-center">
    <div class="flex flex-col lg:flex-row lg:px-20 md:px-10 px-5">
      <div class="lg:mr-10">
        <div class="mb-5">
          <h1 class="text-6xl font-bold">¿Te gusta nuestro trabajo?</h1>
        </div>
        <div>
          <p>
            Contáctenos para cotizar tu sesión de fotos y volverla inolvidable,
            todos merecen en un momento alguna sesión de fotos inolvidable, <span
              class="font-bold">vive con nosotros la experiencia</span
            >.
          </p>
        </div>
      </div>

      <div class="lg:ml-10 mt-10">
        <Planes />
      </div>
    </div>
  </section>

  <section class="h-auto my-10 content-center">
    <div
      class="max-w-7xl mx-auto px-5 grid grid-cols-1 lg:grid-cols-2 gap-16 items-start"
    >
      <Calculadora />
      <FAQ />
    </div>
  </section>
</div>

<script is:inline>
  // Tabs Script
  const buttons = document.querySelectorAll(".tab-btn");
  const contents = document.querySelectorAll(".tab-content");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn.hasAttribute("disabled")) return;

      const target = btn.dataset.tab;

      // Desactivar todos los botones con transición de opacidad
      buttons.forEach((b) => {
        b.classList.remove("active", "text-white");
        if (!b.hasAttribute("disabled")) {
          b.classList.add("text-[#cacaca]");
        }
        const bg = b.querySelector(".tab-bg");
        if (bg) {
          bg.classList.remove("opacity-100");
          bg.classList.add("opacity-0");
        }
      });

      // Ocultar contenidos
      contents.forEach((c) => c.classList.add("hidden"));

      // Activar botón seleccionado
      btn.classList.add("active", "text-white");
      btn.classList.remove("text-[#cacaca]");

      const activeBg = btn.querySelector(".tab-bg");
      if (activeBg) {
        activeBg.classList.remove("opacity-0");
        activeBg.classList.add("opacity-100");
      }

      // Mostrar contenido activo
      document.getElementById(target)?.classList.remove("hidden");
    });
  });

  // Modal Script
  const modal = document.getElementById("modal");
  const modalImg = document.getElementById("modalImg");

  document.querySelectorAll(".card").forEach((card) => {
    const img = card.querySelector("img");

    card.addEventListener("mousemove", (e) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      card.style.transform = `perspective(600px) rotateX(${-y * 8}deg) rotateY(${x * 8}deg)`;
      card.style.transition = "transform 0.1s ease-out";
    });

    card.addEventListener("mouseleave", () => {
      card.style.transform = `perspective(600px) rotateX(0deg) rotateY(0deg)`;
      card.style.transition = "transform 0.4s ease-out";
    });

    card.addEventListener("click", () => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");

      modalImg.src = img.dataset.original || img.src;

      setTimeout(() => {
        modalImg.classList.remove("scale-95");
        modalImg.classList.add("scale-100");
      }, 10);
    });
  });

  modal.addEventListener("click", () => {
    modalImg.classList.remove("scale-100");
    modalImg.classList.add("scale-95");

    setTimeout(() => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }, 200);
  });

  // Parallax Script
  const heroBg = document.getElementById("heroBg");

  window.addEventListener(
    "scroll",
    () => {
      const scrollY = window.scrollY;
      if (heroBg) heroBg.style.transform = `translateY(${scrollY * 0.4}px)`;
    },
    { passive: true },
  );

  // Typewriter Script con color condicional

  const words = [
    "ahora eternos.",
    "ahora vivos.",
    "ahora memorables.",
    "ahora inolvidables.",
  ];

  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const target = document.getElementById("typewriter");
  const cursor = document.getElementById("typewriter-cursor");

  const typingSpeed = 100;
  const deletingSpeed = 50;
  const delayBetweenWords = 2000;

  function typeEffect() {
    if (!target) return;

    const currentWord = words[wordIndex];

    // Cambiar color a naranja SOLO si la palabra actual es "ahora eternos."
    if (currentWord === "ahora eternos.") {
      target.className = "text-[#f95602] transition-colors duration-300";
      if (cursor)
        cursor.className = "animate-pulse ml-0.5 font-normal text-[#f95602]";
    } else {
      target.className = "text-white transition-colors duration-300";
      if (cursor)
        cursor.className = "animate-pulse ml-0.5 font-normal text-white";
    }

    if (isDeleting) {
      target.textContent = currentWord.substring(0, charIndex - 1);
      charIndex--;
    } else {
      target.textContent = currentWord.substring(0, charIndex + 1);
      charIndex++;
    }

    let nextSpeed = isDeleting ? deletingSpeed : typingSpeed;

    if (!isDeleting && charIndex === currentWord.length) {
      nextSpeed = delayBetweenWords;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      wordIndex = (wordIndex + 1) % words.length;
      nextSpeed = 300;
    }

    setTimeout(typeEffect, nextSpeed);
  }

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    target.textContent = "ahora eternos.";
    target.className = "text-[#f95602]";
  }

  typeEffect();
</script>
