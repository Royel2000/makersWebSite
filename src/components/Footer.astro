---
import { Image } from "astro:assets";
import imagen1 from "/src/assets/Makers.svg";
import Icon from "/src/assets/MK.jpg";
---

<section id="footer">
<footer class="bg-[#000000] text-[#cacaca] w-full px-6 md:px-20 lg:px-40 pt-12 pb-6 mt-20" style="font-family: 'Outfit', sans-serif;">

  <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-8 border-b border-white/[0.07]">

    <!-- Marca -->
    <div>
      <!-- <Image src={Icon} alt="Makers ícono" width={48} height={48}
        class="rounded-xl mb-3 object-cover" /> -->
      <Image src={imagen1} alt="Makers Fotografía y Video"
        class="w-36 mb-3" />
      <p class="text-[#cacaca]">Momentos únicos,<br />ahora eternos.</p>
    </div>

    <!-- Contacto -->
    <div>
      <p class="font-black text-xl uppercase text-[#f95602] mb-4">Contacto</p>
      <ul class="flex flex-col gap-1">
        <li>
          <a href="https://www.facebook.com/share/1EAGavYuJx/"
            class="group inline-flex items-center gap-2.5 text-[#cacaca] hover:text-white transition-colors duration-300">
            <i class="ti ti-brand-facebook text-lg group-hover:text-[#f95602] transition-colors duration-300"></i>
            Facebook
          </a>
        </li>
        <li>
          <a href="https://www.instagram.com/_makers_2"
            class="group inline-flex items-center gap-2.5 text-[#cacaca] hover:text-white transition-colors duration-300">
            <i class="ti ti-brand-instagram text-lg group-hover:text-[#f95602] transition-colors duration-300"></i>
            Instagram
          </a>
        </li>
        <li>
          <a href="mailto:makers25117@gmail.com"
            class="group inline-flex items-center gap-2.5 text-[#cacaca] hover:text-white transition-colors duration-300">
            <i class="ti ti-mail text-lg group-hover:text-[#f95602] transition-colors duration-300"></i>
            makers25117@gmail.com
          </a>
        </li>
      </ul>
    </div>

    <!-- Estudio -->
    <div>
      <p class="font-black text-xl uppercase text-[#f95602] mb-4">Estudio</p>
      <div class=" text-[#cacaca] leading-loose">
        <p class="flex items-center gap-2 text-sm">
          Felipe Carrillo Puerto - Quintana Roo, México</p>
        <p class="mt-3 text-[#cacaca] font-bold text-sm">Equipo:</p>
        <p>Angel Kau · Daniel Kau</p>
        <p>Yassim · Henry Eli</p>
      </div>
    </div>

  </div>

  <div class="flex flex-col md:flex-row justify-between items-center pt-5 gap-2">
    <p class="text-[12px] text-[#cacaca] tracking-wide">© 2025 Makers Fotografía y Video — Felipe Carrillo Puerto</p>
    <p class="text-[12px] text-[#f95602]">desde 2025</p>
  </div>

</footer>
</section>