---
import "/src/assets/global.css";
import { Image } from "astro:assets";

const allImages = import.meta.glob("/src/assets/pictures/Casual/*.jpg", {
  eager: true,
});

const fotos = Object.entries(allImages)
  .filter(([path]) => !path.includes("Posters"))
  .map(([_, mod]) => (mod as any).default)
  .slice(0, 22);
---

<section class="text-[#cacaca] lg:px-20 md:px-10 px-5 my-20">
  <div class="relative">
    <div
      id="galleryContainer"
      class="columns-2 sm:columns-3 lg:columns-4 gap-4 max-h-300 overflow-hidden transition-[max-height] duration-1000 ease-in-out relative"
    >
      {
        fotos.map((foto, i) => (
          <div
            class="card group relative mb-4 break-inside-avoid rounded-xl overflow-hidden cursor-pointer gallery-item transition-all duration-700 ease-out opacity-0 translate-y-6"
            style="transform-style: preserve-3d;"
          >
            <Image
              src={foto}
              alt={`Fotografía casual ${i + 1}`}
              class="w-full h-auto object-cover group-hover:scale-[1.03] transition-transform duration-900"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300" />
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="w-10 h-10 rounded-full border border-white/30 backdrop-blur-sm bg-white/10 flex items-center justify-center">
                <i class="ti ti-zoom-in text-white text-lg" />
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div
      id="galleryFade"
      class="absolute bottom-0 left-0 right-0 h-full bg-linear-to-t from-[#111111] to-transparent pointer-events-none transition-opacity duration-700 ease-in-out z-10"
    >
    </div>
  </div>

  <div class="flex justify-center mt-6 relative z-20">
    <button
      id="expandGalleryBtn"
      class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#111111] border border-white/10 text-xs sm:text-sm font-semibold text-[#cacaca] hover:text-white hover:border-white/20 transition-all duration-300 cursor-pointer select-none active:scale-95"
    >
      <span id="btnText">Ver más fotografías</span>
      <svg
        id="btnIcon"
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4 text-[#f95602] transition-transform duration-500"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"
        />
      </svg>
    </button>
  </div>
</section>

<script is:inline>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-6");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05 },
  );

  const galleryItems = document.querySelectorAll(".gallery-item");
  galleryItems.forEach((el) => observer.observe(el));

  const galleryContainer = document.getElementById("galleryContainer");
  const galleryFade = document.getElementById("galleryFade");
  const expandBtn = document.getElementById("expandGalleryBtn");
  const btnText = document.getElementById("btnText");
  const btnIcon = document.getElementById("btnIcon");

  let isExpanded = false;

  expandBtn?.addEventListener("click", () => {
    isExpanded = !isExpanded;

    if (isExpanded) {
      galleryContainer.style.maxHeight = "9999px";
      galleryFade?.classList.add("opacity-0");
      if (btnText) btnText.textContent = "Mostrar menos";
      btnIcon?.classList.add("rotate-180");

      galleryItems.forEach((el) => observer.observe(el));
    } else {
      galleryContainer.style.maxHeight = "1200px";
      galleryFade?.classList.remove("opacity-0");
      if (btnText) btnText.textContent = "Ver más fotografías";
      btnIcon?.classList.remove("rotate-180");
      galleryContainer?.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  });
</script>