---
---
<section class="py-10 px-5 text-[#cacaca]">
  <div class="max-w-lg mx-auto">
    <h2 class="text-3xl font-bold mb-8">Calcule su sesión</h2>

    <div class="space-y-4">
      <div>
        <label class="block text-sm text-zinc-400 mb-1" for="fotos">Número de fotos</label>
        <input id="fotos" type="number" min="1" placeholder="ej. 70"
          class="w-full p-2.5 bg-[#111111] text-[#cacaca] border border-zinc-700 rounded-lg focus:outline-none focus:border-[#f95602] transition-colors" />
      </div>

      <div>
        <label class="block text-sm text-zinc-400 mb-1" for="horas">Horas de sesión</label>
        <input id="horas" type="number" min="1" placeholder="ej. 2"
          class="w-full p-2.5 bg-[#111111] text-[#cacaca] border border-zinc-700 rounded-lg focus:outline-none focus:border-[#f95602] transition-colors" />
      </div>

      <label class="flex items-center gap-3 text-sm text-zinc-400 cursor-pointer">
        <input type="checkbox" id="fuera" class="w-4 h-4 accent-[#f95602]" />
        ¿Sesión fuera de Felipe Carrillo Puerto?
      </label>

      <div id="kmContainer" class="hidden">
        <label class="block text-sm text-zinc-400 mb-1">Distancia (km)</label>
        <input id="km" type="number" min="1" placeholder="ej. 45"
          class="w-full p-2.5 bg-[#111111] text-[#cacaca] border border-zinc-700 rounded-lg focus:outline-none focus:border-[#f95602] transition-colors" />
      </div>
    </div>

    <div id="resultado" class="hidden mt-6 bg-[#1a1a1a] border border-zinc-700 rounded-xl p-5 space-y-2">
      <div class="flex justify-between text-sm text-zinc-400">
        <span>Fotos (<span id="r-fotos"></span>)</span>
        <span id="r-precio-fotos"></span>
      </div>
      <div id="r-horas-row" class="flex justify-between text-sm text-zinc-400">
        <span>Tiempo (<span id="r-horas"></span> h)</span>
        <span id="r-precio-horas"></span>
      </div>
      <div id="r-viaticos-row" class="hidden flex justify-between text-sm text-zinc-400">
        <span>Viáticos (<span id="r-km"></span> km)</span>
        <span id="r-precio-viaticos"></span>
      </div>
      <hr class="border-zinc-700 my-1" />
      <div class="flex justify-between items-baseline">
        <span class="text-base font-semibold">Total estimado</span>
        <span id="r-total" class="text-3xl font-bold text-[#f95602]"></span>
      </div>
      <span id="r-paquete" class="inline-block text-xs px-3 py-1 rounded-full bg-[#f95602]/10 text-[#f95602] mt-1"></span>
      <p class="text-xs text-zinc-600 pt-1">Precios en MXN. Viáticos y servicios extra se cotizan por separado.</p>
    </div>
  </div>
</section>

<script is:inline>
  const fEl = document.getElementById('fotos');
  const hEl = document.getElementById('horas');
  const fueraEl = document.getElementById('fuera');
  const kmEl = document.getElementById('km');
  const kmContainer = document.getElementById('kmContainer');
  const resultado = document.getElementById('resultado');

  fueraEl.addEventListener('change', () => {
    kmContainer.classList.toggle('hidden', !fueraEl.checked);
    calcular();
  });

  [fEl, hEl, kmEl].forEach(el => el?.addEventListener('input', calcular));

  function fmt(n) {
    return '$' + n.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calcular() {
    const fotos = parseInt(fEl.value) || 0;
    const horas = parseInt(hEl.value) || 0;
    const km = parseInt(kmEl.value) || 0;

    if (fotos === 0 && horas === 0) { resultado.classList.add('hidden'); return; }

    let precioPorFoto = 0, paquete = '';
    if (fotos < 40)       { precioPorFoto = 22.5; paquete = 'Paquete Básico (hasta 40 fotos)'; }
    else if (fotos < 70)  { precioPorFoto = 21.5; paquete = 'Paquete Platino (hasta 70 fotos)'; }
    else if (fotos < 150) { precioPorFoto = 22;   paquete = 'Paquete Dorado (hasta 100 fotos)'; }
    else                  { precioPorFoto = 21;   paquete = 'Cotización personalizada (+150 fotos)'; }

    const totalFotos = fotos * precioPorFoto;
    const totalHoras = horas * 100;
    const viaticos = fueraEl.checked ? km * 10 : 0;
    const total = totalFotos + totalHoras + viaticos;

    document.getElementById('r-fotos').textContent = fotos;
    document.getElementById('r-precio-fotos').textContent = fmt(totalFotos);
    document.getElementById('r-horas').textContent = horas;
    document.getElementById('r-precio-horas').textContent = fmt(totalHoras);
    document.getElementById('r-horas-row').classList.toggle('hidden', horas === 0);

    const vRow = document.getElementById('r-viaticos-row');
    if (fueraEl.checked && km > 0) {
      document.getElementById('r-km').textContent = km;
      document.getElementById('r-precio-viaticos').textContent = fmt(viaticos);
      vRow.classList.remove('hidden');
    } else { vRow.classList.add('hidden'); }

    document.getElementById('r-total').textContent = fmt(total);
    document.getElementById('r-paquete').textContent = paquete;
    resultado.classList.remove('hidden');
  }
</script>