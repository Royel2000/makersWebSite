---

---

<section
  class="py-16 px-5 text-[#cacaca]"
  style="font-family: 'Outfit', sans-serif;"
>
  <div class="max-w-lg mx-auto">
    <p
      class="text-[10px] font-bold tracking-[0.22em] uppercase text-[#f95602]/70 mb-2"
    >
      Herramienta de cotización
    </p>
    <h2 class="text-4xl font-extrabold text-white mb-6">
      Calcula tu <span class="text-[#f95602]">sesión</span>
    </h2>

    <!-- Servicios -->
    <div class="grid grid-cols-2 gap-3 mb-4">
      <label
        class="servicio-card relative border border-white/[0.07] rounded-2xl p-4 cursor-pointer transition-all duration-200 bg-[#181818] hover:border-[#f95602]/25"
        id="card-foto"
      >
        <input
          type="checkbox"
          id="chk-foto"
          class="absolute opacity-0 w-0 h-0"
          checked
        />
        <div
          class="s-check absolute top-2.5 right-2.5 w-4.25 h-4.25 rounded-full border border-white/12 flex items-center justify-center transition-all duration-200"
        >
          <span class="s-check-mark text-white opacity-0" style="font-size:9px;"
            >✓</span
          >
        </div>
        <p
          class="text-[10px] font-bold tracking-widest uppercase text-[#cacaca]/35 mb-1"
        >
          Servicio
        </p>
        <p class="text-[15px] font-bold text-white">Fotografía</p>
        <p class="text-[11px] text-[#cacaca]/35 mt-0.5">
          Sesión + edición de fotos
        </p>
      </label>
      <label
        class="servicio-card relative border border-white/[0.07] rounded-2xl p-4 cursor-pointer transition-all duration-200 bg-[#181818] hover:border-[#f95602]/25"
        id="card-video"
      >
        <input
          type="checkbox"
          id="chk-video"
          class="absolute opacity-0 w-0 h-0"
        />
        <div
          class="s-check absolute top-2.5 right-2.5 w-4.25 h-4.25 rounded-full border border-white/12 flex items-center justify-center transition-all duration-200"
        >
          <span class="s-check-mark text-white opacity-0" style="font-size:9px;"
            >✓</span
          >
        </div>
        <p
          class="text-[10px] font-bold tracking-widest uppercase text-[#cacaca]/35 mb-1"
        >
          Servicio
        </p>
        <p class="text-[15px] font-bold text-white">Video</p>
        <p class="text-[11px] text-[#cacaca]/35 mt-0.5">Grabación + edición</p>
      </label>
    </div>

    <div class="flex flex-col gap-3">
      <!-- Grupo Fotografía -->
      <div
        class="border border-white/6 rounded-2xl overflow-hidden"
        id="grupo-foto"
      >
        <div class="px-4 py-2.5 bg-[#161616] border-b border-white/5">
          <p
            class="text-[10px] font-bold tracking-[0.18em] uppercase text-[#f95602]/65"
          >
            Fotografía
          </p>
        </div>
        <div class="p-3.5 bg-[#1a1a1a] grid grid-cols-2 gap-3">
          <div>
            <label
              class="block text-[10px] font-bold tracking-widest uppercase text-[#cacaca]/35 mb-1.5"
              >Núm. de fotos</label
            >
            <input
              id="fotos"
              type="number"
              min="1"
              placeholder="70"
              class="w-full bg-[#111111] border border-white/[0.07] rounded-xl px-3 py-2.5 text-white text-[15px] font-bold outline-none focus:border-[#f95602] focus:shadow-[0_0_0_3px_rgba(249,86,2,0.08)] transition-all placeholder:text-[#cacaca]/18 placeholder:font-normal"
            />
          </div>
          <div>
            <label
              class="block text-[10px] font-bold tracking-widest uppercase text-[#cacaca]/35 mb-1.5"
              >Horas de sesión</label
            >
            <input
              id="horas-foto"
              type="number"
              min="1"
              placeholder="2"
              class="w-full bg-[#111111] border border-white/[0.07] rounded-xl px-3 py-2.5 text-white text-[15px] font-bold outline-none focus:border-[#f95602] focus:shadow-[0_0_0_3px_rgba(249,86,2,0.08)] transition-all placeholder:text-[#cacaca]/18 placeholder:font-normal"
            />
          </div>
          <div class="col-span-2">
            <label
              class="flex items-center gap-2.5 px-3 py-2.5 bg-[#111111] border border-white/[0.07] rounded-xl cursor-pointer hover:border-[#f95602]/30 transition-colors"
            >
              <input
                type="checkbox"
                id="fuera"
                class="w-3.5 h-3.5 accent-[#f95602]"
              />
              <span class="text-xs text-[#cacaca]/45 font-medium"
                >Fuera de Felipe Carrillo Puerto</span
              >
            </label>
            <div
              id="kmContainer"
              class="overflow-hidden transition-all duration-300"
              style="max-height:0;opacity:0;"
            >
              <div class="mt-2">
                <label
                  class="block text-[10px] font-bold tracking-widest uppercase text-[#cacaca]/35 mb-1.5"
                  >Distancia en km</label
                >
                <input
                  id="km"
                  type="number"
                  min="1"
                  placeholder="45"
                  class="w-full bg-[#111111] border border-white/[0.07] rounded-xl px-3 py-2.5 text-white text-[15px] font-bold outline-none focus:border-[#f95602] focus:shadow-[0_0_0_3px_rgba(249,86,2,0.08)] transition-all placeholder:text-[#cacaca]/18 placeholder:font-normal"
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Grupo Video -->
      <div
        class="border border-white/6 rounded-2xl overflow-hidden"
        id="grupo-video"
        style="display:none;"
      >
        <div class="px-4 py-2.5 bg-[#161616] border-b border-white/5">
          <p
            class="text-[10px] font-bold tracking-[0.18em] uppercase text-[#f95602]/65"
          >
            Video
          </p>
        </div>
        <div class="p-3.5 bg-[#1a1a1a] grid grid-cols-2 gap-3">
          <div>
            <label
              class="block text-[10px] font-bold tracking-widest uppercase text-[#cacaca]/35 mb-1.5"
              >Horas de grabación</label
            >
            <input
              id="horas-video"
              type="number"
              min="1"
              placeholder="2"
              class="w-full bg-[#111111] border border-white/[0.07] rounded-xl px-3 py-2.5 text-white text-[15px] font-bold outline-none focus:border-[#f95602] focus:shadow-[0_0_0_3px_rgba(249,86,2,0.08)] transition-all placeholder:text-[#cacaca]/18 placeholder:font-normal"
            />
          </div>
          <div>
            <label
              class="block text-[10px] font-bold tracking-widest uppercase text-[#cacaca]/35 mb-1.5"
              >Minutos entregados</label
            >
            <input
              id="minutos-video"
              type="number"
              min="1"
              placeholder="3"
              class="w-full bg-[#111111] border border-white/[0.07] rounded-xl px-3 py-2.5 text-white text-[15px] font-bold outline-none focus:border-[#f95602] focus:shadow-[0_0_0_3px_rgba(249,86,2,0.08)] transition-all placeholder:text-[#cacaca]/18 placeholder:font-normal"
            />
          </div>
          <div class="col-span-2">
            <label
              class="flex items-center gap-2.5 px-3 py-2.5 bg-[#111111] border border-white/[0.07] rounded-xl cursor-pointer hover:border-[#f95602]/30 transition-colors"
            >
              <input
                type="checkbox"
                id="reel"
                class="w-3.5 h-3.5 accent-[#f95602]"
              />
              <span class="text-xs text-[#cacaca]/45 font-medium"
                >Solo reel para redes sociales (hasta 60 seg.) — $600 todo
                incluido</span
              >
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Resultado -->
    <div
      id="resultado"
      class="mt-4 rounded-2xl border border-white/[0.07] overflow-hidden opacity-0 translate-y-3 pointer-events-none"
      style="transition: opacity 0.4s ease, transform 0.4s ease;"
    >
      <div id="res-bloques"></div>

      <!-- Dentro del div#resultado, después del res-pie -->
      <div
        id="contacto-wrap"
        class="hidden px-5 py-4 bg-[#111111] border-t border-white/4"
      >
        <label class="flex items-center gap-3 cursor-pointer group">
          <input
            type="checkbox"
            id="chk-contacto"
            class="w-4 h-4 accent-[#f95602]"
          />
          <span
            class="text-sm text-[#cacaca]/50 group-hover:text-[#cacaca]/70 transition-colors"
          >
            ¿Quieres que te contactemos con esta cotización?
          </span>
        </label>

        <div id="form-contacto" class="hidden mt-4 flex-col gap-3">
          <div>
            <label
              class="block text-[10px] font-bold tracking-widest uppercase text-[#cacaca]/35 mb-1.5"
              >Tu nombre</label
            >
            <input
              id="c-nombre"
              type="text"
              placeholder="Ej. María González"
              class="w-full bg-[#1a1a1a] border border-white/[0.07] rounded-xl px-3 py-2.5 text-white text-sm font-medium outline-none focus:border-[#f95602] focus:shadow-[0_0_0_3px_rgba(249,86,2,0.08)] transition-all placeholder:text-[#cacaca]/20"
            />
          </div>
          <div>
            <label
              class="block text-[10px] font-bold tracking-widest uppercase text-[#cacaca]/35 mb-1.5"
              >Tu correo (opcional)</label
            >
            <input
              id="c-email"
              type="email"
              placeholder="para que te respondamos"
              class="w-full bg-[#1a1a1a] border border-white/[0.07] rounded-xl px-3 py-2.5 text-white text-sm font-medium outline-none focus:border-[#f95602] focus:shadow-[0_0_0_3px_rgba(249,86,2,0.08)] transition-all placeholder:text-[#cacaca]/20"
            />
          </div>
          <div>
            <label
              class="block text-[10px] font-bold tracking-widest uppercase text-[#cacaca]/35 mb-1.5"
              >Fecha tentativa (opcional)</label
            >
            <input
              id="c-fecha"
              type="date"
              class="w-full bg-[#1a1a1a] border border-white/[0.07] rounded-xl px-3 py-2.5 text-white text-sm font-medium outline-none focus:border-[#f95602] focus:shadow-[0_0_0_3px_rgba(249,86,2,0.08)] transition-all"
            />
          </div>

          <button
            id="btn-enviar"
            class="w-full mt-1 py-3 rounded-xl bg-[#f95602] text-white text-sm font-bold tracking-[0.08em] uppercase hover:bg-[#e04e00] active:scale-[0.98] transition-all duration-200"
          >
            Enviar cotización por correo
          </button>
          <p class="text-[10px] text-[#cacaca]/25 text-center">
            Abre tu cliente de correo con la cotización lista para enviar
          </p>
        </div>
      </div>

      <div
        class="px-5 py-4 flex justify-between items-center bg-[#111111] border-t border-white/[0.07]"
      >
        <span
          class="text-[10px] font-bold tracking-[0.18em] uppercase text-[#cacaca]/25"
          >Total estimado</span
        >
        <span
          id="r-total"
          class="text-4xl font-extrabold text-[#f95602] tracking-tight"
          style="transition: transform 0.25s ease, filter 0.25s ease;"></span>
      </div>

      <div
        class="px-5 pb-4 pt-2 flex justify-between items-center bg-[#111111] border-t border-white/4"
      >
        <span
          id="r-paquete"
          class="text-[10px] font-bold tracking-[0.06em] uppercase px-3 py-1 rounded-full bg-[#f95602]/8 text-[#f95602]/70"
        ></span>
        <span class="text-[10px] text-[#cacaca]/18">Precios en MXN</span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .servicio-card.active {
    border-color: #f95602;
    background: rgba(249, 86, 2, 0.04);
  }
  .servicio-card.active .s-check {
    background: #f95602;
    border-color: #f95602;
  }
  .servicio-card.active .s-check-mark {
    opacity: 1;
  }
  .res-bloque {
    padding: 14px 18px;
    background: #181818;
  }
  .res-bloque + .res-bloque {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .res-bloque-titulo {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(249, 86, 2, 0.55);
    margin-bottom: 10px;
  }
  .res-fila {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 5px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  .res-fila:last-child {
    border: none;
  }
  .res-fila-label {
    font-size: 12px;
    color: rgba(202, 202, 202, 0.4);
    font-weight: 500;
    font-family: "Outfit", sans-serif;
  }
  .res-fila-valor {
    font-size: 12px;
    color: rgba(202, 202, 202, 0.65);
    font-weight: 700;
    font-family: "Outfit", sans-serif;
  }
</style>

<script is:inline>
  const chkFoto = document.getElementById("chk-foto");
  const chkVideo = document.getElementById("chk-video");
  const cardFoto = document.getElementById("card-foto");
  const cardVideo = document.getElementById("card-video");
  const grupoFoto = document.getElementById("grupo-foto");
  const grupoVideo = document.getElementById("grupo-video");
  const fueraEl = document.getElementById("fuera");
  const kmContainer = document.getElementById("kmContainer");
  const resultado = document.getElementById("resultado");
  const totalEl = document.getElementById("r-total");
  let prevTotal = 0;

  function updateCards() {
    cardFoto.classList.toggle("active", chkFoto.checked);
    cardVideo.classList.toggle("active", chkVideo.checked);
    grupoFoto.style.display = chkFoto.checked ? "block" : "none";
    grupoVideo.style.display = chkVideo.checked ? "block" : "none";
    calcular();
  }

  chkFoto.addEventListener("change", updateCards);
  chkVideo.addEventListener("change", updateCards);
  cardFoto.classList.add("active");

  fueraEl.addEventListener("change", () => {
    kmContainer.style.maxHeight = fueraEl.checked ? "70px" : "0";
    kmContainer.style.opacity = fueraEl.checked ? "1" : "0";
    calcular();
  });

  document.getElementById("reel").addEventListener("change", calcular);
  ["fotos", "horas-foto", "km", "horas-video", "minutos-video"].forEach(
    (id) => {
      document.getElementById(id)?.addEventListener("input", calcular);
    },
  );

  function fmt(n) {
    return (
      "$" +
      n.toLocaleString("es-MX", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      })
    );
  }

  function fila(label, valor) {
    return `<div class="res-fila"><span class="res-fila-label">${label}</span><span class="res-fila-valor">${valor}</span></div>`;
  }

  function calcular() {
    const tieneFoto = chkFoto.checked;
    const tieneVideo = chkVideo.checked;
    if (!tieneFoto && !tieneVideo) {
      resultado.style.opacity = "0";
      resultado.style.transform = "translateY(10px)";
      resultado.style.pointerEvents = "none";
      return;
    }

    let bloques = "";
    let total = 0;
    let paquetes = [];

    if (tieneFoto) {
      const fotos = parseInt(document.getElementById("fotos").value) || 0;
      const horas = parseInt(document.getElementById("horas-foto").value) || 0;
      const km = parseInt(document.getElementById("km").value) || 0;
      let precioPorFoto = 0,
        paquete = "";
      if (fotos < 40) {
        precioPorFoto = 22.5;
        paquete = "Básico";
      } else if (fotos < 70) {
        precioPorFoto = 21.5;
        paquete = "Platino";
      } else if (fotos < 150) {
        precioPorFoto = 22;
        paquete = "Dorado";
      } else {
        precioPorFoto = 21;
        paquete = "Personalizado";
      }
      const tFotos = fotos * precioPorFoto;
      const tHoras = horas * 100;
      const tViat = fueraEl.checked ? km * 10 : 0;
      if (fotos > 0 || horas > 0) {
        let filas = "";
        if (fotos > 0) {
          filas += fila(`${fotos} fotos × $${precioPorFoto}`, fmt(tFotos));
          if (paquete) paquetes.push("Foto · " + paquete);
        }
        if (horas > 0) filas += fila(`Sesión · ${horas} h × $100`, fmt(tHoras));
        if (tViat > 0) filas += fila(`Viáticos · ${km} km × $10`, fmt(tViat));
        bloques += `<div class="res-bloque"><p class="res-bloque-titulo">Fotografía</p>${filas}</div>`;
        total += tFotos + tHoras + tViat;
      }
    }

    if (tieneVideo) {
      const esReel = document.getElementById("reel").checked;
      const hV = parseInt(document.getElementById("horas-video").value) || 0;
      const mV = parseInt(document.getElementById("minutos-video").value) || 0;
      if (esReel) {
        bloques += `<div class="res-bloque"><p class="res-bloque-titulo">Video</p>${fila("Reel para redes · hasta 60 seg.", fmt(600))}</div>`;
        total += 600;
        paquetes.push("Video · Reel");
      } else if (hV > 0 || mV > 0) {
        const tGrab = hV > 0 ? Math.ceil(hV / 2) * 800 : 0;
        const extra = Math.max(0, mV - 3);
        const tEdit = mV > 0 ? 900 + extra * 120 : 0;
        let filas = "";
        if (hV > 0) filas += fila(`Grabación · ${hV} h`, fmt(tGrab));
        if (mV > 0)
          filas += fila(
            `Edición · ${mV} min${extra > 0 ? ` (+${extra} extra)` : ""}`,
            fmt(tEdit),
          );
        bloques += `<div class="res-bloque"><p class="res-bloque-titulo">Video</p>${filas}</div>`;
        total += tGrab + tEdit;
        paquetes.push("Video · Completo");
      }
    }

    if (total === 0) {
      resultado.style.opacity = "0";
      resultado.style.transform = "translateY(10px)";
      resultado.style.pointerEvents = "none";
      return;
    }

    document.getElementById("res-bloques").innerHTML = bloques;
    totalEl.textContent = fmt(total);
    document.getElementById("r-paquete").textContent = paquetes.join("  ·  ");
    resultado.style.opacity = "1";
    resultado.style.transform = "translateY(0)";
    resultado.style.pointerEvents = "auto";
    mostrarContacto();

    if (total !== prevTotal) {
      totalEl.style.transform = "scale(1.1)";
      totalEl.style.filter = "brightness(1.3)";
      setTimeout(() => {
        totalEl.style.transform = "scale(1)";
        totalEl.style.filter = "brightness(1)";
      }, 250);
      prevTotal = total;
    }
  }

  // Mostrar sección de contacto cuando hay resultado
  function mostrarContacto() {
    document.getElementById("contacto-wrap").classList.remove("hidden");
  }

  // Toggle formulario
  document
    .getElementById("chk-contacto")
    .addEventListener("change", function () {
      document
        .getElementById("form-contacto")
        .classList.toggle("hidden", !this.checked);
    });

  // Botón enviar
  document.getElementById("btn-enviar").addEventListener("click", () => {
    const nombre =
      document.getElementById("c-nombre").value.trim() || "Cliente";
    const email = document.getElementById("c-email").value.trim();
    const fecha = document.getElementById("c-fecha").value;
    const total = totalEl.textContent;
    const paquete = document.getElementById("r-paquete").textContent;

    // Construir cuerpo del correo
    const bloques = document.getElementById("res-bloques");
    let detalle = "";
    bloques.querySelectorAll(".res-fila").forEach((fila) => {
      const label = fila.querySelector(".res-fila-label")?.textContent || "";
      const valor = fila.querySelector(".res-fila-valor")?.textContent || "";
      detalle += `  • ${label}: ${valor}\n`;
    });

    const fechaTxt = fecha
      ? `Fecha tentativa: ${new Date(fecha + "T12:00:00").toLocaleDateString("es-MX", { weekday: "long", year: "numeric", month: "long", day: "numeric" })}\n`
      : "";
    const emailTxt = email ? `Correo de respuesta: ${email}\n` : "";

    const asunto = `Cotización Makers Fotografía y Video — ${nombre}`;
    const cuerpo = `Hola, equipo de Makers Fotografía y Video.

Mi nombre es ${nombre} y me gustaría solicitar una cotización con los siguientes detalles:

━━━━━━━━━━━━━━━━━━━━━
RESUMEN DE COTIZACIÓN
━━━━━━━━━━━━━━━━━━━━━
${detalle}
Paquete: ${paquete}
Total estimado: ${total} MXN
━━━━━━━━━━━━━━━━━━━━━
${fechaTxt}${emailTxt}
Quedo en espera de su respuesta para confirmar disponibilidad.

Saludos,
${nombre}`;

    const mailto = `mailto:makers25117@gmail.com?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
    window.location.href = mailto;
  });

  // Llamar mostrarContacto() al final de calcular() cuando hay resultado
  // Agrega esta línea al final del if(total !== prevTotal){} en calcular():
  // mostrarContacto();
</script>
