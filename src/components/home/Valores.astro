---
---
<section class="relative overflow-hidden my-16">
  <div class="marquee-wrap relative overflow-hidden py-6">
    <div class="pointer-events-none absolute inset-y-0 left-0 w-20 z-10" style="background: linear-gradient(to right, var(--bg-primary), transparent);"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-20 z-10" style="background: linear-gradient(to left, var(--bg-primary), transparent);"></div>

    <div class="marquee-track flex w-max whitespace-nowrap hover:[animation-play-state:paused]">
      {["Creatividad","Calidad","Velocidad","Honestidad","Respeto","Responsabilidad","Humildad","Creatividad","Calidad","Velocidad","Honestidad","Respeto","Responsabilidad","Humildad"].map(v => (
        <span class="inline-flex items-center gap-3 mx-6 text-base font-bold uppercase text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-300">
          <span class="w-1 h-1 rounded-full bg-[var(--accent)] opacity-60 shrink-0"></span>
          {v}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-track { animation: scroll 25s linear infinite; }
  @keyframes scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
</style>
