---
import "/src/assets/global.css";
import { Image } from "astro:assets";

interface Props {
  folder: string;
  label: string;
  exclude?: string;
}

const { folder, label, exclude } = Astro.props;

const allImages = import.meta.glob("/src/assets/pictures/*/*.jpg", {
  eager: true,
});

const fotos = Object.entries(allImages)
  .filter(([path]) => path.includes(`/${folder}/`))
  .filter(([path]) => !exclude || !path.includes(exclude))
  .map(([_, mod]) => (mod as any).default);

const wide = fotos.map((foto) => foto.width / foto.height > 1.25);
---

<div
  class="grid grid-flow-dense grid-cols-2 gap-1.5 auto-rows-[230px] sm:grid-cols-3 sm:auto-rows-[320px] lg:grid-cols-4 lg:auto-rows-[400px]"
  role="list"
  aria-label={`Galería ${label}`}
>
  {
    fotos.map((foto, i) => (
      <div
        class:list={[
          "gallery-item group relative border border-[var(--border-default)] overflow-hidden cursor-pointer hover:border-[var(--border-hover)]",
          wide[i] && "sm:col-span-2",
        ]}
        role="listitem"
        data-reveal
        style={`--reveal-delay: ${(i % 8) * 60}ms;`}
      >
        <div
          class="relative h-full will-change-transform transition-transform duration-[550ms] ease-[var(--ease-out-quart)] group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        >
          <Image
            src={foto}
            alt={`${label} ${i + 1}`}
            class="w-full h-full object-cover"
            data-original={foto.src}
          />

          <!-- Degradado inferior en hover -->
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            style="background:linear-gradient(to top, rgba(0,0,0,0.55), transparent 55%);"
          />

          <!-- Lupa glass centrada -->
          <div
            class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 scale-90 group-hover:scale-100"
          >
            <div
              class="w-11 h-11 rounded-full glass-strong flex items-center justify-center text-white"
              style="border:1px solid rgba(255,255,255,0.25);box-shadow:0 4px 20px rgba(0,0,0,0.35);"
            >
              <svg
                class="w-5 h-5 text-white drop-shadow"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6"
                />
              </svg>
            </div>
          </div>

          <!-- Chip glass con categoría -->
          <div
            class="absolute bottom-3 left-3 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500"
          >
            <div
              class="glass-strong flex items-center gap-2 pl-3 pr-2 py-1.5 rounded-full"
              style="border:1px solid rgba(255,255,255,0.18);"
            >
              <span class="text-white text-[11px] font-bold tracking-[0.12em] uppercase">
                {label}
              </span>
              <span
                class="w-5 h-5 rounded-full bg-[var(--accent)] text-white text-[10px] font-extrabold flex items-center justify-center"
              >
                {i + 1}
              </span>
            </div>
          </div>
        </div>
      </div>
    ))
  }
</div>