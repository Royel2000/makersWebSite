---
import "/src/assets/global.css";
import { Image } from "astro:assets";

const allImages = import.meta.glob("/src/assets/pictures/Posters/*.jpg", {
  eager: true,
});
const fotos = Object.entries(allImages).map(([_, mod]) => (mod as any).default);
---

<section class="text-[var(--text-secondary)] my-20">
  <div data-reveal class="mb-12 px-5 lg:px-20 md:px-10">
    <h2
      class="text-4xl md:text-5xl font-extrabold leading-tight text-left text-[var(--text-primary)]"
    >
      Diseños
      <span class="relative inline-block ml-3"
        >únicos
        <svg
          class="absolute left-0 -bottom-1 w-full h-4"
          viewBox="0 0 200 20"
          preserveAspectRatio="none"
        >
          <path
            d="M5 15 Q100 25 195 10"
            stroke="#f95602"
            stroke-width="6"
            fill="none"
            stroke-linecap="round"></path>
        </svg>
      </span>
    </h2>
    <p
      class="mt-5 text-[11px] font-semibold tracking-[0.18em] uppercase text-[var(--text-muted)]"
    >
      Identidad visual · Posters · Contenido para redes
    </p>
  </div>

  <div class="relative w-full overflow-hidden" id="carousel-wrap">
    <div
      class="relative w-full flex items-center justify-center"
      id="carousel-track"
    >
      {
        fotos.map((foto, i) => (
          <div
            class="poster-slide absolute rounded-2xl overflow-hidden cursor-pointer"
            data-index={i}
            style="will-change:transform,opacity,filter;"
          >
            <Image
              src={foto}
              alt={`Diseño ${i + 1}`}
              class="w-full h-full object-cover"
              width={300}
              height={420}
              data-original={foto.src}
            />
            <div
              class="absolute inset-0 transition-opacity duration-700"
              style="background:linear-gradient(135deg,rgba(255,255,255,0.06) 0%,rgba(255,255,255,0.01) 100%);border:1px solid rgba(255,255,255,0.08);opacity:0;"
            />
            <div
              class="poster-overlay absolute inset-0 transition-all duration-700"
              style="background:rgba(0,0,0,0.55);opacity:1;"
            />
            <div
              class="absolute top-0 left-0 right-0 h-24 pointer-events-none"
              style="background:linear-gradient(to bottom,rgba(255,255,255,0.04),transparent);"
            />
            <div
              class="poster-accent absolute bottom-0 left-0 right-0 h-0.5 transition-opacity duration-700 opacity-0"
              style="background:linear-gradient(to right,transparent,#f95602,transparent);"
            />
            <div class="poster-zoom absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300">
              <div
                class="w-11 h-11 rounded-full flex items-center justify-center"
                style="background:rgba(249,86,2,0.15);border:1px solid rgba(249,86,2,0.4);backdrop-filter:blur(8px);"
              >
                <svg class="w-[18px] h-[18px] text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" /></svg>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <button
      id="prev-btn"
      type="button"
      aria-label="Poster anterior"
      class="arrow-btn absolute z-30 flex items-center justify-center transition-all duration-300"
      style="left:12px;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;background:rgba(17,17,17,0.85);border:1px solid rgba(255,255,255,0.08);backdrop-filter:blur(12px);"
    >
      <svg class="w-[18px] h-[18px] text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
    </button>
    <button
      id="next-btn"
      type="button"
      aria-label="Poster siguiente"
      class="arrow-btn absolute z-30 flex items-center justify-center transition-all duration-300"
      style="right:12px;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;background:rgba(17,17,17,0.85);border:1px solid rgba(255,255,255,0.08);backdrop-filter:blur(12px);"
    >
      <svg class="w-[18px] h-[18px] text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
    </button>
  </div>

  <div class="flex justify-center items-center gap-2 mt-6" id="dots-wrap"></div>
</section>

<style is:global>
  .arrow-btn:hover {
    border-color: rgba(249, 86, 2, 0.5) !important;
    background: rgba(249, 86, 2, 0.1) !important;
  }
  .arrow-btn:hover svg {
    color: #f95602 !important;
  }
  .arrow-btn:active {
    transform: translateY(-50%) scale(0.93) !important;
  }

  .poster-slide {
    --parallax-y: 0px;
  }
</style>
