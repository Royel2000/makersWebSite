---
import "/src/assets/global.css";
import { Image } from "astro:assets";

const allImages = import.meta.glob("/src/assets/pictures/Posters/*.jpg", {
  eager: true,
});
const fotos = Object.entries(allImages).map(([_, mod]) => (mod as any).default);
---

<section class="text-[var(--text-secondary)] my-20" data-nav-label="Diseños">
  <div data-reveal class="mb-12 px-5 lg:px-20 md:px-10">
    <h2
      class="text-4xl md:text-5xl font-extrabold leading-tight text-left text-[var(--text-primary)]"
    >
      Diseños
      <span class="relative inline-block ml-3"
        >únicos
        <svg
          class="absolute left-0 -bottom-1 w-full h-4"
          viewBox="0 0 200 20"
          preserveAspectRatio="none"
        >
          <path
            d="M5 15 Q100 25 195 10"
            stroke="#f95602"
            stroke-width="6"
            fill="none"
            stroke-linecap="round"></path>
        </svg>
      </span>
    </h2>
    <p
      class="mt-5 text-[11px] font-semibold tracking-[0.18em] uppercase text-[var(--text-muted)]"
    >
      Identidad visual · Posters · Contenido para redes
    </p>
  </div>

  <div class="relative w-full overflow-hidden" id="carousel-wrap">
    <div
      class="relative w-full flex items-center justify-center"
      id="carousel-track"
    >
      {
        fotos.map((foto, i) => (
          <div
            class="poster-slide absolute overflow-hidden rounded-2xl border border-white/10 shadow-[0_12px_40px_rgba(0,0,0,0.4)] cursor-pointer"
            data-index={i}
            style="will-change:transform,opacity,filter;--parallax-y:0px;"
          >
            <Image
              src={foto}
              alt={`Diseño ${i + 1}`}
              class="w-full h-full object-cover"
              width={380}
              height={570}
              data-original={foto.src}
            />

            <!-- Marco plateado interior -->
            <div
              class="pointer-events-none absolute inset-0 rounded-2xl ring-1 ring-inset ring-white/10"
            />

            <!-- Oscurecedor en tarjetas vecinas -->
            <div
              class="poster-overlay absolute inset-0 transition-opacity duration-700"
              style="background:rgba(0,0,0,0.55);opacity:1;"
            />

            <!-- Brillo superior -->
            <div
              class="pointer-events-none absolute top-0 left-0 right-0 h-24"
              style="background:linear-gradient(to bottom,rgba(255,255,255,0.07),transparent);"
            />

            <!-- Línea de acento inferior (solo activa) -->
            <div
              class="poster-accent absolute bottom-0 left-0 right-0 h-[3px] opacity-0 transition-opacity duration-700"
              style="background:linear-gradient(to right,transparent,#f95602,transparent);box-shadow:0 0 18px rgba(249,86,2,0.55);"
            />

            <!-- Chip de número (solo activa) -->
            <div
              class="poster-chip absolute bottom-3 left-3 flex items-center gap-2 opacity-0 transition-opacity duration-500"
            >
              <span
                class="glass-strong rounded-full border border-white/20 px-3 py-1 text-[10px] font-bold tracking-[0.14em] text-white uppercase"
                >Diseño</span
              >
              <span
                class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--accent)] text-[11px] font-extrabold text-white shadow-[0_0_16px_rgba(249,86,2,0.6)]"
                >{String(i + 1).padStart(2, "0")}</span
              >
            </div>

            <!-- Lupa indicadora -->
            <div
              class="poster-zoom absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300"
            >
              <div
                class="glass-strong flex h-11 w-11 items-center justify-center rounded-full"
                style="border:1px solid rgba(255,255,255,0.25);"
              >
                <svg class="w-[18px] h-[18px] text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" /></svg>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <button
      id="prev-btn"
      type="button"
      aria-label="Poster anterior"
      class="absolute z-30 top-1/2 left-4 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-black/70 text-white/70 shadow-[0_8px_24px_rgba(0,0,0,0.35)] backdrop-blur-xl transition-all duration-300 hover:border-[rgba(249,86,2,0.5)] hover:bg-[rgba(249,86,2,0.12)] hover:text-[var(--accent)] hover:shadow-[0_0_24px_rgba(249,86,2,0.3)] active:scale-95"
    >
      <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
    </button>
    <button
      id="next-btn"
      type="button"
      aria-label="Poster siguiente"
      class="absolute z-30 top-1/2 right-4 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-black/70 text-white/70 shadow-[0_8px_24px_rgba(0,0,0,0.35)] backdrop-blur-xl transition-all duration-300 hover:border-[rgba(249,86,2,0.5)] hover:bg-[rgba(249,86,2,0.12)] hover:text-[var(--accent)] hover:shadow-[0_0_24px_rgba(249,86,2,0.3)] active:scale-95"
    >
      <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
    </button>
  </div>

  <div
    class="mt-6 flex justify-center items-center gap-2"
    id="dots-wrap"
  ></div>
</section>