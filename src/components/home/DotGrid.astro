---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "pointer-events-none absolute inset-0 z-0 overflow-hidden text-(--dot-color)",
    className,
  ]}
  aria-hidden="true"
>
  <svg
    class="absolute inset-0 h-full w-full"
    width="100%"
    height="100%"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern
        id="dotGrid"
        x="0"
        y="0"
        width="32"
        height="32"
        patternUnits="userSpaceOnUse"
      >
        <circle cx="16" cy="16" r="1" fill="currentColor" opacity="0.5"
        ></circle>
      </pattern>
      <pattern
        id="dotGridAccent"
        x="0"
        y="0"
        width="96"
        height="96"
        patternUnits="userSpaceOnUse"
      >
        <circle cx="16" cy="16" r="1.5" fill="var(--accent)" opacity="0.25"
        ></circle>
      </pattern>
      <radialGradient id="dotFade" cx="50%" cy="40%" r="60%">
        <stop offset="0%" stop-color="white" stop-opacity="1"></stop>
        <stop offset="100%" stop-color="white" stop-opacity="0"></stop>
      </radialGradient>
      <mask id="dotMask">
        <rect width="100%" height="100%" fill="url(#dotFade)"></rect>
      </mask>
    </defs>
    <g mask="url(#dotMask)">
      <rect width="100%" height="100%" fill="url(#dotGrid)"></rect>
      <rect width="100%" height="100%" fill="url(#dotGridAccent)"></rect>
    </g>
  </svg>
</div>
