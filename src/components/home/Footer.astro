    class="relative overflow-hidden rounded-t-[28px] border border-[var(--border-default)] bg-[var(--bg-card)] shadow-[0_-24px_80px_-40px_rgba(0,0,0,0.65)]"
  >
    <DotGrid class="opacity-40" />
    <AmbientGlow variant="dual" class="opacity-60" />

    <!-- CTA -->
    <div class="relative z-10 px-6 pt-16 pb-12 md:px-12 text-center" data-reveal>
      <span
        class="inline-flex items-center gap-2 rounded-full border border-[rgba(var(--accent-rgb),0.35)] bg-[rgba(var(--accent-rgb),0.08)] px-3.5 py-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-[var(--accent)]"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)] shadow-[0_0_8px_rgba(249,86,2,0.9)]"></span>
        Contacto directo
      </span>

      <h2
        class="mt-5 text-3xl md:text-5xl font-black tracking-tight text-[var(--text-primary)] leading-tight"
