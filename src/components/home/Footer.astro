---
import { Image } from "astro:assets";
import logo from "/src/assets/Makers.svg";

const year = new Date().getFullYear();
---

<footer
  id="footer"
  data-nav-label="Contacto"
  class="footer relative mt-20 w-full"
>
  <div class="footer-inner">
    <div class="footer-columns" data-reveal>
      <div class="footer-col">
        <p class="footer-heading">INDICE</p>
        <nav aria-label="Navegación">
          <a class="footer-link" href="#hero">
            Inicio
          </a>
          <a class="footer-link" href="#aboutUs">
            Nosotros
          </a>
          <a class="footer-link" href="#Galeria">
            Galería
          </a>
          <a class="footer-link" href="#video">
            Video
          </a>
          <a class="footer-link" href="#footer">
            Contacto
          </a>
          <a class="footer-link" href="#hero">
            Volver arriba
          </a>
        </nav>
      </div>

      <div class="footer-col">
        <p class="footer-heading">CONTACTO</p>
        <a class="footer-link" href="mailto:makers25117@gmail.com">
          makers25117@gmail.com
        </a>
        <a
          class="footer-link"
          href="https://wa.me/529831820066?text=Hola%20Makers!%20Quiero%20cotizar%20una%20sesi%C3%B3n%20%2F%20evento"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp +52 983 182 0066
        </a>
        <p class="footer-copy">{year} Makers Fotografía y Video</p>
      </div>

      <div class="footer-col">
        <p class="footer-heading">REDES SOCIALES</p>
        <div class="footer-socials">
          <a
            href="https://www.instagram.com/_makers_2"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="footer-social"
          >
            <svg
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
          <a
            href="https://www.facebook.com/share/1EAGavYuJx/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="footer-social"
          >
            <svg
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-wordmark">
      <Image src={logo} alt="Makers Fotografía y Video" />
    </div>
  </div>
</footer>

<style>
  .footer {
    overflow: hidden;
    background: linear-gradient(
      180deg,
      rgba(15, 15, 15, 0) 0%,
      rgba(8, 8, 8, 0.4) 50%,
      rgb(0, 0, 0) 100%
    );
  }
  .footer-inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 75px 20px 0;
  }
  .footer-columns {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 50px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .footer-heading {
    margin: 0 0 7px;
    font-family: "Outfit", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.6;
    text-transform: uppercase;
    color: rgba(233, 233, 233, 0.7);
  }
  .footer-link {
    display: block;
    width: fit-content;
    font-family: "Outfit", sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.6;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(233, 233, 233, 0.7);
    transition: color 0.25s ease;
  }
  .footer-link:hover {
    color: #fff;
  }
  .footer-socials {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .footer-social {
    display: inline-flex;
    color: rgba(233, 233, 233, 0.7);
    transition: color 0.25s ease;
  }
  .footer-social:hover {
    color: #fff;
  }
  .footer-copy {
    margin: 10px 0 0;
    font-family: "Outfit", sans-serif;
    font-size: 13px;
    color: rgba(233, 233, 233, 0.45);
  }
  .footer-wordmark {
    width: 100%;
    margin: 50px auto 0;
    overflow: hidden;
  }
  .footer-wordmark img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (min-width: 768px) {
    .footer-inner {
      padding: 75px 30px 0;
    }
    .footer-columns {
      flex-direction: row;
      gap: 62px;
    }
    .footer-col {
      flex: 0 1 auto;
      min-width: 125px;
    }
  }
</style>
