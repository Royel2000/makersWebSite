---
import { Image } from "astro:assets";
import imagen1 from "/src/assets/Makers.svg";
import AmbientGlow from "./AmbientGlow.astro";
import DotGrid from "./DotGrid.astro";

const year = new Date().getFullYear();
---

<footer
