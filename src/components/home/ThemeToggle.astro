---
<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Cambiar modo claro/oscuro"
  title="Cambiar tema"
>
  <!-- Sol (visible en modo oscuro) -->
  <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
  </svg>
  <!-- Luna (visible en modo claro) -->
  <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
  </svg>
</button>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const html = document.documentElement;
    const sun = btn.querySelector('.icon-sun');
    const moon = btn.querySelector('.icon-moon');

    function updateIcons() {
      const isDark = html.classList.contains('dark');
      if (sun) sun.style.display = isDark ? 'block' : 'none';
      if (moon) moon.style.display = isDark ? 'none' : 'block';
    }

    updateIcons();

    btn.addEventListener('click', () => {
      const isDark = html.classList.contains('dark');
      const next = isDark ? 'light' : 'dark';

      html.classList.add('theme-transitioning');
      html.className = html.className.replace(/\b(dark|light)\b/, next);
      html.style.colorScheme = next === 'dark' ? 'dark' : 'light';
      localStorage.setItem('theme', next);

      updateIcons();

      setTimeout(() => {
        html.classList.remove('theme-transitioning');
      }, 450);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle);
  } else {
    initThemeToggle();
  }
</script>

<style>
  :global(html.dark) .icon-sun { display: block; }
  :global(html.dark) .icon-moon { display: none; }
  :global(html.light) .icon-sun { display: none; }
  :global(html.light) .icon-moon { display: block; }
</style>
