---
const CHANNEL_INPUT = "UClpgO6x3-xCI8opTuWcmMUA";

const FALLBACK = [
  { id: "IVYbODWOXFA", title: "Boda - Willbert y Cesia" },
  { id: "A6_jIHEAwTE", title: "Misión Iglesia Bautista Gracia" },
];

const thumb = (id: string) => `https://i.ytimg.com/vi/${id}/mqdefault.jpg`;

let fromFeed = false;

const decodeXml = (s: string) =>
  s
    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, "$1")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&#39;/g, "'")
    .replace(/&amp;/g, "&");

async function resolveChannelId(input: string): Promise<string | null> {
  const value = input.trim();
  if (/^UC[\w-]{22}$/.test(value)) return value;
  if (/^@[^\s/]+$/u.test(value)) {
    try {
      const res = await fetch(
        `https://www.youtube.com/${encodeURIComponent(value)}/videos`,
        {
          headers: { "User-Agent": "Mozilla/5.0" },
        },
      );
      if (!res.ok) return null;
      const html = await res.text();
      const match =
        html.match(/"channelId":"(UC[\w-]{22})"/) ||
        html.match(/"externalId":"(UC[\w-]{22})"/) ||
        html.match(/"browseId":"(UC[\w-]{22})"/);
      return match?.[1] ?? null;
    } catch {
      return null;
    }
  }
  return null;
}

async function getVideos() {
  if (!CHANNEL_INPUT) return FALLBACK;
  const channelId = await resolveChannelId(CHANNEL_INPUT);
  if (!channelId) return FALLBACK;

  try {
    const res = await fetch(
      `https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}`,
    );
    if (!res.ok) return FALLBACK;
    const xml = await res.text();
    const parsed = xml
      .split("<entry>")
      .slice(1, 9)
      .map((entry) => {
        const id = entry.match(/<yt:videoId>([^<]+)<\/yt:videoId>/)?.[1];
        const title = entry.match(/<title>([^<]+)<\/title>/)?.[1];
        if (!id || !title) return null;
        return { id, title: decodeXml(title).trim() };
      })
      .filter((v): v is { id: string; title: string } => v !== null);

    if (!parsed.length) return FALLBACK;
    fromFeed = true;
    return parsed;
  } catch {
    return FALLBACK;
  }
}

const VIDEOS = await getVideos();

const mainVideo = { ...VIDEOS[0], thumb: thumb(VIDEOS[0].id) };
const carouselVideos = VIDEOS.map((v) => ({ ...v, thumb: thumb(v.id) }));
---

<section
  id="video"
  class="relative w-full py-16 px-5 md:px-10 lg:px-20 overflow-hidden"
  data-nav-label="Video"
>
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-dots"
    aria-hidden="true"
    style="mask-image:radial-gradient(ellipse 90% 70% at 50% 40%, black 40%, transparent 100%);-webkit-mask-image:radial-gradient(ellipse 90% 70% at 50% 40%, black 40%, transparent 100%);"
  >
  </div>

  <div
    data-reveal
    class="relative z-10 flex flex-col md:flex-row items-start md:items-end justify-center gap-6 mb-10"
  >
    <div class="text-left">
      <p
        class="text-[11px] font-bold tracking-[0.18em] uppercase text-(--accent) opacity-70 mb-1"
      >
        Nuestro trabajo
      </p>
      <h2
        class="text-4xl md:text-5xl font-extrabold leading-tight text-(--text-primary)"
      >
        En <span class="text-(--accent)">movimiento</span>
      </h2>
    </div>

    <div class="text-left md:text-right max-w-xs">
      <p
        class="text-sm md:text-base leading-relaxed text-(--text-muted) italic"
      >
        "Las fotos detienen el tiempo. El video lo devuelve."
      </p>
    </div>
  </div>

  <div
    class="relative z-10 flex flex-col md:flex-row items-stretch justify-center gap-6 max-w-6xl mx-auto"
  >
    <div
      data-reveal
      data-reveal-delay="120"
      class="relative z-10 w-full md:w-[780px] shrink-0 rounded-2xl overflow-hidden bg-black"
      style="aspect-ratio:16/9;box-shadow:0 12px 40px rgba(0,0,0,0.4),0 0 0 1px rgba(255,255,255,0.06);"
      id="main-player-wrap"
      data-video-id={mainVideo.id}
    >
      <div id="main-poster" class="absolute inset-0 z-10 cursor-pointer group">
        <img
          id="main-thumb"
          src={mainVideo.thumb.replace("mqdefault", "maxresdefault")}
          width={780}
          height={439}
          fetchpriority="high"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
          alt={mainVideo.title}
        />
        <div
          class="absolute inset-0"
          style="background:linear-gradient(to top,rgba(0,0,0,0.7) 0%,rgba(0,0,0,0.1) 60%,transparent 100%);"
        >
        </div>
        <div
          class="absolute inset-0 flex flex-col items-center justify-center gap-4"
        >
          <div
            class="w-16 h-16 md:w-20 md:h-20 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110"
            style="background:rgba(1,1,1,0.95);border:2px solid rgba(255,255,255,0.15);box-shadow:0 0 40px rgba(1,1,1,0.4);"
          >
            <svg
              class="w-7 h-7 text-white"
              style="margin-left:4px;"
              fill="currentColor"
              viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg
            >
          </div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-5">
          <p
            class="text-[11px] font-bold tracking-[0.18em] uppercase text-(--accent) opacity-70 mb-1"
          >
            {fromFeed ? "Último video" : "Video promocional"}
          </p>
          <p id="main-title" class="text-white font-bold text-lg leading-tight">
            {mainVideo.title}
          </p>
        </div>
      </div>

      <div id="main-player-host" class="absolute inset-0">
        <div id="main-player"></div>
      </div>

      <button
        id="video-sound-btn"
        type="button"
        class="video-sound-btn"
        hidden
        aria-label="Activar sonido"
      >
        <svg
          data-sound-icon="off"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5 6 9H3v6h3l5 4V5Zm5 4 5 6m0-6-5 6"></path></svg
        >
        <svg
          data-sound-icon="on"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
          hidden><path stroke-linecap="round" stroke-linejoin="round" d="M11 5 6 9H3v6h3l5 4V5Zm4.5 3.5a5 5 0 0 1 0 7m2.5-9.5a8.5 8.5 0 0 1 0 12"></path></svg
        >
        <span id="video-sound-label">Activar sonido</span>
      </button>

      <button
        id="video-controls-btn"
        type="button"
        class="video-sound-btn video-controls-btn"
        hidden
        aria-label="Mostrar controles de YouTube"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8.4-3a8.4 8.4 0 0 0-.1-1.3l2-1.5-2-3.4-2.3.9a8 8 0 0 0-2.3-1.3L15.3 3H8.7l-.4 2.4a8 8 0 0 0-2.3 1.3l-2.3-.9-2 3.4 2 1.5a8.4 8.4 0 0 0 0 2.6l-2 1.5 2 3.4 2.3-.9a8 8 0 0 0 2.3 1.3l.4 2.4h6.6l.4-2.4a8 8 0 0 0 2.3-1.3l2.3.9 2-3.4-2-1.5c.1-.4.1-.9.1-1.3Z"></path></svg
        >
        <span>Controles</span>
      </button>
    </div>

    {
      carouselVideos.length > 0 && (
        <div class="w-full md:w-[200px] shrink-0 md:self-stretch">
          <div
            class="flex gap-3 overflow-x-auto md:flex-col md:overflow-x-hidden md:overflow-y-auto pb-2 md:pb-0 snap-x snap-mandatory md:snap-none scroll-smooth md:h-full md:justify-start"
            id="video-carousel"
          >
            {carouselVideos.map((v) => (
              <button
                class="video-thumb-btn group relative rounded-xl overflow-hidden shrink-0 snap-start border border-(--border-default) transition-all duration-300 hover:border-(--accent) focus:outline-none"
                style="width:200px;height:112px;"
                data-id={v.id}
                data-title={v.title}
              >
                <img
                  src={v.thumb}
                  width={200}
                  height={112}
                  loading="lazy"
                  alt={v.title}
                  class="w-full h-full object-cover opacity-60 group-hover:opacity-90 transition-opacity duration-300"
                />
                <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors duration-300" />
                <div
                  class="absolute bottom-0 left-0 right-0 p-2"
                  style="background:linear-gradient(to top,rgba(0,0,0,0.8),transparent);"
                >
                  <p class="text-white text-[10px] font-semibold leading-tight line-clamp-2 text-left">
                    {v.title}
                  </p>
                </div>
              </button>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style is:global>
  #main-player-host iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  #main-player-wrap.is-playing #main-player-host iframe {
    opacity: 1;
  }
  #main-player-wrap.is-playing #main-poster {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .video-sound-btn {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 9999px;
    background: rgba(1, 1, 1, 0.82);
    backdrop-filter: blur(8px);
    color: #fff;
    font-family: "Outfit", sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.25s ease,
      background 0.25s ease;
  }
  .video-sound-btn:hover {
    border-color: var(--accent);
    background: rgba(249, 86, 2, 0.9);
  }
  .video-sound-btn[hidden],
  .video-sound-btn svg[hidden] {
    display: none;
  }
  .video-controls-btn {
    right: 16px;
    bottom: 62px;
  }
  #video-carousel {
    scrollbar-width: thin;
    scrollbar-color: rgba(249, 86, 2, 0.5) transparent;
  }
  #video-carousel::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  #video-carousel::-webkit-scrollbar-thumb {
    background: rgba(249, 86, 2, 0.5);
    border-radius: 999px;
  }
  #video-carousel::-webkit-scrollbar-track {
    background: transparent;
  }

  /* La lista alcanza la misma altura que el reproductor (16/9) en desktop */
  @media (min-width: 768px) and (max-width: 1023px) {
    #video-carousel {
      max-height: calc(min(780px, 100vw - 304px) * 9 / 16);
    }
  }
  @media (min-width: 1024px) {
    #video-carousel {
      max-height: calc(min(780px, 100vw - 384px) * 9 / 16);
    }
  }
</style>
