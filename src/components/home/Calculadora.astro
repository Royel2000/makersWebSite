---
import logo from "../../assets/MakersDark.svg?inline";
---

<section class="py-16 px-5 text-[var(--text-secondary)]">
  <div data-reveal class="max-w-lg mx-auto">

    <p class="text-[11px] font-bold tracking-[0.18em] uppercase text-[var(--accent)] opacity-70 mb-2">
      Cotización rápida
    </p>
    <h2 class="text-4xl md:text-5xl font-extrabold leading-tight text-[var(--text-primary)] mb-2">
      ¿Qué <span class="text-[var(--accent)]">necesitas</span>?
    </h2>
    <p class="text-sm text-[var(--text-muted)] mb-8">
      Elige los servicios y ajusta los detalles. El precio se actualiza solo.
    </p>

    <div
      id="banner-promo"
      role="status"
      class="hidden banner-promo mb-6"
    ></div>

    <!-- Servicios -->
    <div class="flex gap-3 mb-5">
      <label
        for="chk-foto"
        class="servicio-card flex-1 relative rounded-2xl p-5 cursor-pointer transition-all duration-300 bg-[var(--bg-secondary)] border-2 border-[var(--border-default)] hover:border-[var(--border-strong)]"
        id="card-foto"
      >
        <input type="checkbox" id="chk-foto" class="absolute opacity-0 w-0 h-0" checked />
        <div class="s-check absolute top-3.5 right-3.5 w-5 h-5 rounded-full border-2 border-[var(--border-strong)] flex items-center justify-center transition-all duration-300">
          <span class="s-check-mark text-white opacity-0 transition-opacity duration-300" style="font-size:10px;">✓</span>
        </div>
        <p class="text-[11px] font-bold tracking-widest uppercase text-[var(--text-muted)] mb-1">Servicio</p>
        <p class="text-lg font-bold text-[var(--text-primary)] leading-tight">Fotografía</p>
        <p class="text-[12px] text-[var(--text-muted)] mt-1">Fotos editadas + sesión</p>
      </label>
      <label
        for="chk-video"
        class="servicio-card flex-1 relative rounded-2xl p-5 cursor-pointer transition-all duration-300 bg-[var(--bg-secondary)] border-2 border-[var(--border-default)] hover:border-[var(--border-strong)]"
        id="card-video"
      >
        <input type="checkbox" id="chk-video" class="absolute opacity-0 w-0 h-0" />
        <div class="s-check absolute top-3.5 right-3.5 w-5 h-5 rounded-full border-2 border-[var(--border-strong)] flex items-center justify-center transition-all duration-300">
          <span class="s-check-mark text-white opacity-0 transition-opacity duration-300" style="font-size:10px;">✓</span>
        </div>
        <p class="text-[11px] font-bold tracking-widest uppercase text-[var(--text-muted)] mb-1">Servicio</p>
        <p class="text-lg font-bold text-[var(--text-primary)] leading-tight">Video</p>
        <p class="text-[12px] text-[var(--text-muted)] mt-1">Grabación + edición</p>
      </label>
    </div>

    <!-- Grupos -->
    <div class="flex flex-col gap-4">

      <!-- Grupo Fotografía -->
      <div
        id="grupo-foto"
        class="calc-group rounded-2xl overflow-hidden transition-all duration-500"
        style="opacity:1; transform:translateY(0);"
      >
        <div class="px-4 py-3 bg-[var(--bg-tertiary)] border-b border-[var(--border-subtle)] flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] opacity-60"></span>
          <p class="text-[11px] font-bold tracking-[0.16em] uppercase text-[var(--text-tertiary)]">Fotografía</p>
        </div>
        <div class="p-4 bg-[var(--bg-secondary)] flex flex-col gap-4">
          <div class="grid grid-cols-2 gap-4">
            <div class="calc-field">
              <label for="fotos" class="calc-label">¿Cuántas fotos?</label>
              <input id="fotos" type="number" min="1" placeholder="70"
                class="calc-input" />
              <p class="calc-hint">Ej.: 70 fotos editadas para una boda pequeña.</p>
            </div>
            <div class="calc-field">
              <label for="horas-foto" class="calc-label">¿Cuántas horas?</label>
              <input id="horas-foto" type="number" min="1" placeholder="2"
                class="calc-input" />
              <p class="calc-hint">Ej.: 2 horas en la locación el día del evento.</p>
            </div>
          </div>
          <div>
            <label for="fuera" class="calc-toggle">
              <input type="checkbox" id="fuera" class="w-4 h-4 accent-[var(--accent)]" />
              <span>¿Viajamos fuera de la ciudad?</span>
            </label>
            <p class="calc-hint mt-2 ml-1">Se suma un costo por cada km recorrido.</p>
            <div id="kmContainer"
              class="overflow-hidden transition-all duration-400 ease-[cubic-bezier(0.16,1,0.3,1)]"
              style="max-height:0;opacity:0;">
              <div class="calc-field mt-3">
                <label for="km" class="calc-label">¿Cuántos km?</label>
                <input id="km" type="number" min="1" placeholder="45"
                  class="calc-input" />
                <p class="calc-hint">Ej.: 45 km por trayecto hasta la locación.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Grupo Video -->
      <div
        id="grupo-video"
        class="calc-group rounded-2xl overflow-hidden transition-all duration-500"
        style="display:none;opacity:0;transform:translateY(20px);"
      >
        <div class="px-4 py-3 bg-[var(--bg-tertiary)] border-b border-[var(--border-subtle)] flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] opacity-60"></span>
          <p class="text-[11px] font-bold tracking-[0.16em] uppercase text-[var(--text-tertiary)]">Video</p>
        </div>
        <div class="p-4 bg-[var(--bg-secondary)] flex flex-col gap-4">
          <div class="grid grid-cols-2 gap-4">
            <div class="calc-field">
              <label for="horas-video" class="calc-label">¿Cuántas horas?</label>
              <input id="horas-video" type="number" min="1" placeholder="2"
                class="calc-input" />
              <p class="calc-hint">Cada 2 horas de grabación = $800 (se redondea hacia arriba). Ej.: 3 h = $1,600.</p>
            </div>
            <div class="calc-field">
              <label for="minutos-video" class="calc-label">¿Cuántos minutos finales?</label>
              <input id="minutos-video" type="number" min="1" placeholder="3"
                class="calc-input" />
              <p class="calc-hint">Incluye los primeros 3 min por $1,200; cada minuto extra suma $120. Ej.: 7 min = $1,200 + 4 extra.</p>
            </div>
          </div>
          <label for="reel" class="calc-toggle">
            <input type="checkbox" id="reel" class="w-4 h-4 accent-[var(--accent)]" />
            <span>Solo un reel (hasta 60 seg.)</span>
          </label>
          <p class="calc-hint mt-2 ml-1">Ideal para redes sociales. Precio fijo de $600.</p>
        </div>
      </div>
    </div>

    <!-- Resultado -->
    <div
      id="resultado"
      class="mt-5 rounded-2xl border-2 border-[var(--border-default)] overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
      style="opacity:0;transform:translateY(20px);pointer-events:none;"
    >
      <div id="res-bloques"></div>

      <div id="contacto-wrap"
        class="hidden px-5 py-4 bg-[var(--bg-surface)] border-t border-[var(--border-subtle)]"
      >
        <label for="chk-contacto" class="flex items-center gap-3 cursor-pointer group">
          <input type="checkbox" id="chk-contacto" class="w-4 h-4 accent-[var(--accent)]" />
          <span class="text-sm text-[var(--text-tertiary)] group-hover:text-[var(--text-primary)] transition-colors">
            ¿Quieres que te contactemos?
          </span>
        </label>

        <div id="form-contacto" class="hidden mt-4 flex-col gap-3">
          <div class="calc-field">
            <label for="c-nombre" class="calc-label">Tu nombre <span class="text-[var(--accent)]">*</span></label>
            <input id="c-nombre" type="text" placeholder="María González"
              class="calc-input" required />
            <p class="calc-hint">Solo lo usamos para dirigirnos a ti.</p>
          </div>
          <div class="calc-field">
            <label for="c-email" class="calc-label">Tu correo <span class="text-[var(--text-muted)]">(opcional)</span></label>
            <input id="c-email" type="email" placeholder="para que te respondamos"
              class="calc-input" />
            <p class="calc-hint">Ej.: para que te enviemos el presupuesto. Opcional.</p>
          </div>
          <div class="calc-field">
            <label for="c-fecha" class="calc-label">Fecha tentativa <span class="text-[var(--text-muted)]">(opcional)</span></label>
            <input id="c-fecha" type="date"
              class="calc-input" />
            <p class="calc-hint">El día aproximado de tu evento. Opcional.</p>
          </div>
          <button
            id="btn-enviar"
            class="w-full mt-1 py-3.5 rounded-xl bg-[var(--accent)] text-white text-sm font-bold tracking-[0.08em] uppercase hover:bg-[var(--accent-hover)] active:scale-[0.98] transition-all duration-300"
          >
            Enviar por correo
          </button>
          <p id="form-error" class="text-[11px] text-red-400 text-center hidden">
            Por favor ingresa tu nombre para poder contactarte.
          </p>
          <p class="text-[10px] text-[var(--text-muted)] text-center">
            Abre tu correo con la cotización lista
          </p>
        </div>
      </div>

      <div class="px-5 py-4 bg-[var(--bg-surface)] border-t border-[var(--border-subtle)]">
        <div class="flex justify-between items-center">
          <span class="text-[11px] font-bold tracking-[0.12em] uppercase text-[var(--text-muted)]">Total estimado</span>
          <span id="r-total"
            class="text-4xl font-extrabold text-[var(--accent)] tracking-tight transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"></span>
        </div>
        <div id="r-total-old-wrap" class="hidden mt-0.5 flex justify-between items-center">
          <span class="text-[10px] text-[var(--text-muted)]">Precio regular</span>
          <span id="r-total-old"
            class="text-sm font-bold text-[var(--text-muted)] line-through decoration-[var(--accent)] opacity-70"></span>
        </div>
      </div>

      <div class="px-5 pb-4 pt-2 flex justify-between items-center bg-[var(--bg-surface)] border-t border-[var(--border-subtle)]">
        <span id="r-paquete"
          class="text-[10px] font-bold tracking-[0.06em] uppercase px-3 py-1 rounded-full bg-[rgba(var(--accent-rgb),0.08)] text-[var(--accent)] opacity-70"></span>
        <span class="text-[10px] text-[var(--text-muted)]">Precios en MXN</span>
      </div>

      <div
        id="export-wrap"
        class="hidden px-5 py-4 bg-[var(--bg-surface)] border-t border-[var(--border-subtle)] flex gap-2.5"
      >
        <button
          id="btn-export-png"
          class="flex-1 py-3 rounded-xl border-2 border-[var(--border-default)] text-[var(--text-primary)] text-sm font-bold hover:border-[var(--accent)] transition-all duration-300 active:scale-[0.98]"
        >
          Guardar como imagen
        </button>
        <button
          id="btn-export-pdf"
          class="flex-1 py-3 rounded-xl bg-[var(--accent)] text-white text-sm font-bold tracking-[0.04em] uppercase hover:bg-[var(--accent-hover)] active:scale-[0.98] transition-all duration-300"
        >
          Descargar PDF
        </button>
      </div>
    </div>

  </div>

  <!-- Ticket para exportar -->
  <div
    id="ticket"
    aria-hidden="true"
    class="ticket-canvas"
  >
    <img id="ticket-logo" src={logo} alt="Makers Fotografía y Video" class="ticket-logo" />
    <div class="ticket-sub">Fotografía &amp; Video</div>
    <div id="ticket-cliente" class="ticket-cliente"></div>
    <h3 class="ticket-title">Cotización</h3>
    <div id="ticket-detalle"></div>
    <div id="ticket-noiva" class="ticket-noiva"></div>
    <div class="ticket-total">
      <span>Total</span>
      <span id="ticket-total"></span>
    </div>
    <div class="ticket-total-old" id="ticket-total-old"></div>
    <div class="ticket-num" id="ticket-folio"></div>
  </div>
</section>

<style is:global>
  .calc-field {
    position: relative;
  }
  .calc-label {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-tertiary);
    margin-bottom: 8px;
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .calc-label::after {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    transform: scale(0);
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    align-self: center;
  }
  .calc-input {
    width: 100%;
    background: var(--input-bg);
    border: 2px solid var(--border-subtle);
    border-radius: 14px;
    padding: 13px 15px;
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 700;
    font-family: "Outfit", sans-serif;
    outline: none;
    transition:
      border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .calc-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.08);
  }
  .calc-input::placeholder {
    color: var(--text-very-muted);
    font-weight: 400;
  }

  .calc-field:focus-within .calc-label {
    color: var(--text-primary);
  }
  .calc-input:not(:placeholder-shown) {
    border-color: rgba(var(--accent-rgb), 0.35);
  }
  .calc-field:has(.calc-input:not(:placeholder-shown)) .calc-label {
    color: var(--accent);
  }
  .calc-field:has(.calc-input:not(:placeholder-shown)) .calc-label::after {
    opacity: 1;
    transform: scale(1);
  }

  .calc-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--input-bg);
    border: 2px solid var(--border-subtle);
    border-radius: 14px;
    cursor: pointer;
    font-size: 13px;
    color: var(--text-tertiary);
    font-weight: 500;
    transition:
      border-color 0.3s ease,
      color 0.3s ease;
  }
  .calc-toggle:hover {
    border-color: rgba(var(--accent-rgb), 0.2);
    color: var(--text-primary);
  }

  .servicio-card.active {
    border-color: var(--accent);
    background: rgba(var(--accent-rgb), 0.05);
  }
  .servicio-card.active .s-check {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1);
  }
  .servicio-card.active .s-check-mark {
    opacity: 1;
  }

  .res-bloque {
    padding: 16px 20px;
    background: var(--bg-tertiary);
  }
  .res-bloque + .res-bloque {
    border-top: 1px solid var(--border-subtle);
  }
  .res-bloque-titulo {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.7;
    margin-bottom: 12px;
  }
  .res-fila {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
  }
  .res-fila + .res-fila {
    border-top: 1px solid var(--border-subtle);
  }
  .res-fila-label {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .res-fila-valor {
    font-size: 13px;
    color: var(--text-tertiary);
    font-weight: 700;
  }

  .calc-group {
    transition:
      opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .calc-hint {
    font-size: 11px;
    line-height: 1.4;
    color: var(--text-muted);
    margin-top: 5px;
    font-weight: 400;
  }

  .banner-promo {
    position: relative;
    background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.14), rgba(var(--accent-rgb), 0.04));
    border: 1px solid rgba(var(--accent-rgb), 0.35);
    border-radius: 14px;
    padding: 12px 14px;
    font-size: 13px;
    color: var(--text-primary);
    line-height: 1.5;
  }
  .banner-promo strong {
    color: var(--accent);
  }
  .banner-promo .promo-close {
    position: absolute;
    top: 8px;
    right: 10px;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    font-size: 15px;
    cursor: pointer;
    border-radius: 50%;
    transition: color 0.2s ease;
  }
  .banner-promo .promo-close:hover {
    color: var(--text-primary);
  }

  .ticket-canvas {
    position: fixed;
    left: 0;
    top: 0;
    z-index: -1;
    opacity: 0;
    pointer-events: none;
    width: 440px;
    background: #fff;
    color: #18181b;
    font-family: "Outfit", sans-serif;
    padding: 24px 24px;
    border-radius: 14px;
    line-height: 1.35;
    box-sizing: border-box;
    overflow: hidden;
  }
  .ticket-logo {
    display: block;
    width: 240px;
    max-width: 100%;
    height: auto;
    margin: 0 0 4px;
  }
  .ticket-sub {
    font-size: 11px;
    color: #f95602;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .ticket-title {
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #f95602;
    margin: 18px 0 10px;
    padding-bottom: 8px;
    border-bottom: 2px solid #f95602;
  }
  .ticket-cliente,
  .ticket-noiva {
    font-size: 13px;
    color: #3f3f46;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .ticket-cliente {
    background: #f4f4f5;
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 6px;
    white-space: pre-line;
  }
  .ticket-detalle {
    font-size: 13px;
  }
  .ticket-fila {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 7px 0;
    min-width: 0;
    color: #3f3f46;
  }
  .ticket-fila .t-lbl {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
    color: #52525b;
  }
  .ticket-fila .t-val {
    flex: 0 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
    font-weight: 700;
    color: #18181b;
  }
  .ticket-noiva {
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: #18181b;
    margin: 16px 0 4px;
  }
  .ticket-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 14px 2px 0;
    border-top: 2px dashed #e4e4e7;
    min-width: 0;
  }
  .ticket-total .t-total-label {
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #18181b;
    flex: 1 1 auto;
    min-width: 0;
  }
  .ticket-total .t-total-val {
    font-size: 24px;
    font-weight: 800;
    color: #f95602;
    flex: 0 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .ticket-num {
    margin-top: 14px;
    font-size: 10px;
    text-align: center;
    color: #a1a1aa;
    letter-spacing: 0.05em;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .ticket-total-old {
    display: flex;
    justify-content: flex-end;
    font-size: 12px;
    color: #8a8a93;
    text-decoration: line-through;
    text-decoration-color: #f95602;
    margin-top: 2px;
  }

  @media print {
    .ticket-canvas {
      position: static;
      left: 0;
      margin: 0 auto;
    }
  }
</style>
