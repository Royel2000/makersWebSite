---
import { Image } from "astro:assets";
import logo from "../../assets/MK.jpg";
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 flex justify-center pointer-events-none overflow-hidden pb-2 transition-all duration-500"
>
  <div
    id="notch-container"
    class="relative pointer-events-auto flex items-start transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
  >
    <svg
      class="w-5 h-5 -mr-px shrink-0 self-start"
      viewBox="0 0 20 20"
    >
      <path d="M20 0H0C11.0457 0 20 8.95431 20 20V0Z"></path>
    </svg>

    <nav
      id="dynamic-notch"
      aria-label="Global"
      class="flex items-center gap-4 p-1.5 rounded-b-[20px]"
    >
      <a href="#aboutUs" class="flex items-center gap-2.5 group">
        <div
          class="relative flex items-center justify-center overflow-hidden rounded-full h-8 w-8 shrink-0 border border-white/20 group-hover:border-[#f95602] transition-colors duration-300"
        >
          <Image
            src={logo}
            alt="Makers Logo"
            loading="eager"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
            width={60}
            height={60}
          />
        </div>

        <div class="flex items-center gap-1.5">
          <span class="font-bold tracking-wider text-white"> MAKERS </span>
          <span class="hidden sm:inline font-medium text-zinc-400">
            • FOTO & VIDEO
          </span>
        </div>
      </a>

      <div class="h-4 w-px bg-white/15"></div>

      <a
        href="#footer"
        class="inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-1 text-[#f95602] hover:text-white bg-[#f95602]/10 hover:bg-[#f95602] rounded-full border border-[#f95602]/40 hover:border-[#f95602] transition-all duration-300 active:scale-95"
      >
        <span>Contacto</span>
        <span
          aria-hidden="true"
          class="text-[11px] transition-transform duration-300 group-hover:translate-x-0.5"
          >&rarr;</span
        >
      </a>
    </nav>

    <svg
      class="w-5 h-5 -ml-px shrink-0 self-start"
      viewBox="0 0 20 20"
    >
      <path d="M0 0H20C8.95431 0 0 8.95431 0 20V0Z"></path>
    </svg>
  </div>
</header>

<style is:global>
  /* Barra flotante limpia y sólida (sin desenfoque conflictivo).
     Los picos laterales siempre igualan el color del cuerpo. */
  #notch-container {
    --nav-color: #000000;
    --nav-ease: cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: top center;
  }

  #notch-container > svg {
    fill: var(--nav-color);
  }

  #dynamic-notch {
    background: var(--nav-color);
    transition: background 0.4s var(--nav-ease);
  }

  /* Al hacer scroll: fondo un pelín más oscuro y notch ligeramente más
     compacto (transición suave tipo Apple). */
  #navbar.scrolled #dynamic-notch {
    background: #000000;
  }

  #navbar.scrolled #notch-container {
    transform: scale(0.97);
  }

  #notch-container:hover {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    #notch-container,
    #dynamic-notch {
      transition: none !important;
    }
  }
</style>

